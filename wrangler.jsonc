{
  "name": "perfumeshots",
  "main": "./worker.js",
  "compatibility_date": "2026-09-26",
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/collection", "/collection/*", "/api/contact"]
  },
  "r2_buckets": [
    {
      "binding": "PRIVATE_COLLECTION",
      "bucket_name": "perfumeshots-collection-private"
    }
  ]
}
